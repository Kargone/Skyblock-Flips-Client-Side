{
  "schemaVersion": 1,
  "id": "skyblockflips",
  "version": "${version}",
  "name": "Skyblock Flips",
  "description": "A mod that sends chat messages to the Skyblock flips HTTP server",
  "authors": [
    "Kargone"
  ],
  "contact": {
    "homepage": "https://github.com/Kargone/Skyblock-Flips-Client-Side",
    "sources": "https://github.com/Kargone/Skyblock-Flips-Client-Side"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.github.kargone.skyblockflips.SkyblockFlipsClient"
    ]
  },
  "mixins": [
    "skyblockflips.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.5",
    "minecraft": ">=26.1.2 <26.2",
    "java": ">=25",
    "fabric-api": ">=0.155.2"
  }
}
